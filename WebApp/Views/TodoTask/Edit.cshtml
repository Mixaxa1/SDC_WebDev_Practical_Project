@using WebApp.ViewModels
@model CreateTodoTaskViewModel
@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
}
<body>
	<div class="div1">
		<a class="btn" asp-action="Details" asp-route-id="@Model.Id">Back</a>
	</div>

	<form asp-action="Edit" asp-controller="TodoTask" asp-route-id="@Model.Id" method="post">
		<div class="div1">
			@Html.LabelFor(m => m.Title)
			@Html.TextBoxFor(m => m.Title)
		</div>
		<div class="div1">
			@Html.LabelFor(m => m.Description)
			@Html.TextBoxFor(m => m.Description)
		</div>
		<div class="div1">
			@Html.LabelFor(m => m.DueAt)
			<input type="datetime-local" asp-for="DueAt" name="DueAt" id="DueAt" />
		</div>

		<select id="tagSelect">
			<option value="">-- select tag --</option>
			@foreach (var tag in Model.TagSelectionOptions)
			{
				<option value="@tag.Id">@tag.Title</option>
			}
		</select>

		<button type="button" onclick="addTag()">Add</button>

		<div id="selectedTags"></div>

		<div class="div1">
			<input type="submit" />
		</div>
	</form>
</body>

<script>
    let tagIndex = 0;

    function addExistingTag(tagId, tagTitle) {
        if (!tagId) return;
        if (document.querySelector(`[data-tag-id="${tagId}"]`)) return;

		fetch("/Tag/AddTag", {
			method: "POST",
			headers: { "Content-Type": "application/json" },
			body: JSON.stringify({
				id: tagId,
				title: tagTitle,
				index: tagIndex++
			})
		})
		.then(r => r.text())
		.then(html => {
			document.getElementById("selectedTags")
				.insertAdjacentHTML("beforeend", html);
		});
	}

    function addTag() {
        const select = document.getElementById("tagSelect");
        const tagId = select.value;
        const tagTitle = select.options[select.selectedIndex].text;
        addExistingTag(tagId, tagTitle);
    }

    function removeTag(tagId) {
        const tag = document.querySelector(`[data-tag-id="${tagId}"]`);
        if (tag) tag.remove();
    }

	document.addEventListener("DOMContentLoaded", function() {
	@foreach (var tag in Model.SelectedTags)
	{
		<text>
					addExistingTag("@tag.Id", "@tag.Title");
		</text>
	}
	});
</script>