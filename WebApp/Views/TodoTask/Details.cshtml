@using WebApp.Models.TodoTask

@model TodoTaskModel
@*
    For monformation on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
}

<body>
    <a class="btn" asp-controller="TodoList" asp-action="Details" asp-route-id="@Model.ListId">Back</a>

    <h1>@Model.Title</h1>

    <div class="div1">
        @foreach (var tag in Model.Tags)
        {
            <span>@tag.Title</span>
        }
    </div>



    <div class="div1">
        <ul>
            <li class="liHor">
                <a class="btn" asp-action="Edit" asp-route-id="@Model.Id" method="post">Edit task</a>
            </li>
            <li class="liHor">
                <a class="btn" asp-action="Delete" asp-route-id="@Model.Id" asp-route-listId="@Model.ListId">Delete task</a>
            </li>
        </ul>
    </div>

    <div class="div1">
        <h3>Timeline</h3>
        @{
            <p>@Model.CreatedAt - @Model.DueAt</p>
        }
    </div>

    <div class="div1">
        <h3>Description</h3>
        <P>@Model.Description</P>
    </div>
</body>