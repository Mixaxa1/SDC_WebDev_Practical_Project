@using WebApp.Models.TodoTask
@model TodoTaskModel

@{
	var deadlineStatus = "onTime";

	if (Model.DueAt <= DateTime.Now)
	{
		deadlineStatus = "overDue";
	}
}

<tr class="tr-@deadlineStatus">
	<td>@Model.Title</td>
	<td>@Model.Description</td>
	<td>@Model.CreatedAt</td>
	<td>@Model.DueAt</td>
	<td>@Model.Status</td>

	<td>
		<a asp-action="Details" asp-controller="TodoTask" asp-route-id="@Model.Id">See details</a>
	</td>
</tr>